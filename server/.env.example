# ===================== Razorpay (payments) =====================
# From Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-NEVER-in-frontend
# Optional: only if you enable webhooks in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ===================== Bigship (shipping) =====================
# This is the "Bigship Direct" Unified Outbound API — matches the
# app.bigship.direct dashboard. Do NOT use your api.bigship.in credentials here
# unless Bigship support confirms the same login works on both.
BIGSHIP_BASE_URL=https://api.bigship.direct/
BIGSHIP_USER_NAME=your-bigship-login-email
BIGSHIP_PASSWORD=your-bigship-password
BIGSHIP_ACCESS_KEY=your-access-key
# Run GET /api/shipping/warehouses once (after setting the 3 vars above) to
# find your warehouse id — use it for both of these unless you have separate
# pickup/return addresses.
BIGSHIP_PICKUP_LOCATION_ID=
BIGSHIP_RETURN_LOCATION_ID=
# Bigship Direct doesn't publish a category id list — confirm the right id for
# "kids apparel / fashion clothing" via their dashboard's Book Order form or
# apisupport@bigship.in, then set it here. Defaults to "1" if left unset.
BIGSHIP_PRODUCT_CATEGORY_ID=1

# ===================== Admin panel =====================
# Signs admin login sessions — set this to a long random string before deploying.
ADMIN_JWT_SECRET=replace-with-a-long-random-string

# ===================== Server =====================
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,https://www.bashabos.com
